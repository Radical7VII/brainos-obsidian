{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "obsidian": ["node_modules/obsidian"] },
    "module": "ESNext",
    "target": "es2018",
    "lib": ["dom", "es2018"],
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
